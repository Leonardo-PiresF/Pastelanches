# Supabase: Project Settings > API. Sem estas duas, o site roda em modo demonstração
# (dados no próprio navegador), bom para mostrar e testar.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Senha do painel só no modo demonstração. Com Supabase, a equipe entra com e-mail e senha.
VITE_PAINEL_SENHA_DEMO=pastelanches
